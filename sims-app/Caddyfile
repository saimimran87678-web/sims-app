{
    local_certs
    admin off
}

(sims_common) {
    root * public
    encode zstd br gzip
    php_fastcgi 127.0.0.1:9000 127.0.0.1:9001 {
        lb_policy round_robin
        lb_try_duration 1s
    }
    file_server
}

# HTTP on Port 80: Automatically redirect localhost to secure HTTPS, while keeping direct HTTP for LAN devices
:80 {
    @local host localhost 127.0.0.1 sims.local
    redir @local https://{host}{uri} permanent
    import sims_common
}

# Auto-detected local network hosts (LAN IP, Computer Name, sims.local)
import storage/caddy/lan_hosts.caddy

# HTTPS on Port 443: Universal secure access with trusted local TLS certificates
:443 {
    import sims_common
    tls internal {
        on_demand
    }
}
