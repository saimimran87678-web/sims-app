{
    local_certs
    admin off
    auto_https disable_redirects
}

(sims_common) {
    root * public
    encode zstd br gzip

    # Immutable 1-year caching for Vite-hashed bundles
    @build path /build/*
    header @build Cache-Control "public, max-age=31536000, immutable"

    # 30-day caching for static assets
    @static path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2
    header @static Cache-Control "public, max-age=2592000"

    php_fastcgi 127.0.0.1:9000 127.0.0.1:9001 127.0.0.1:9002 127.0.0.1:9003 {
        lb_policy round_robin
        lb_try_duration 1s
    }
    file_server
}

# HTTP on Port 80: Automatically redirect localhost to secure HTTPS, while keeping direct HTTP for LAN devices
:80 {
    @local host localhost 127.0.0.1 sims.local
    redir @local https://{host}{uri} permanent
    import sims_common
}

# Auto-detected local network hosts (LAN IP, Computer Name, sims.local)
import storage/caddy/*.caddy

# HTTPS on Port 443: Universal secure access with trusted local TLS certificates
:443 {
    import sims_common
    tls internal {
        on_demand
    }
}
