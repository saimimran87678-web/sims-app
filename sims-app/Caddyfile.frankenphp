{
    frankenphp {
        num_threads 4
    }
    admin off
    auto_https off
}

:8000 {
    root * /home/saim/SIMS/sims-app/public
    encode zstd br gzip

    # Caching for Vite build assets
    @build path /build/*
    header @build Cache-Control "public, max-age=31536000, immutable"

    # Caching for static assets
    @static path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2
    header @static Cache-Control "public, max-age=2592000"

    php_server
}
