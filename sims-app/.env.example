APP_NAME=Laravel
APP_VERSION=2.5.2
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost
# ASSET_URL=


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
