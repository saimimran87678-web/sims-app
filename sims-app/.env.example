APP_NAME="SIMS Institute Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Default: SQLite local file)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sims_db
# DB_USERNAME=root
# DB_PASSWORD=

# Session & Cookie Configuration (Use 'redis' in production for 0ms RAM sessions)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=false

# System Services & Caching (Use QUEUE_CONNECTION=redis and CACHE_STORE=redis in production)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# Redis Configuration (High-performance RAM storage for sessions, cache, and queues)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (Default: log to storage/logs/laravel.log)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@school.edu.pk"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Database Constraints
DB_FOREIGN_KEYS=true

# WhatsApp Integration Service
WHATSAPP_SERVICE_URL=http://localhost:3000
WHATSAPP_TIMEOUT=15

# SIMS Licensing & Subscriptions (Credentials required from vendor portal)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
LICENSE_KEY=
LICENSE_INTEGRITY_KEY=
LICENSE_RSA_PUBLIC_KEY=
